# API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_supplier

# Redis
REDIS_URL=redis://localhost:6379

# Search
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key-change-me

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Cookie-based auth (dual-mode with headers; set "true" to enable httpOnly cookies)
COOKIE_AUTH_ENABLED=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="CoffeeShopSupplier <noreply@example.com>"

# PDF invoices
INVOICE_DUE_DAYS=30

# Overdue invoices cron schedule (default: daily at 02:00)
OVERDUE_JOB_CRON=0 2 * * *

# API documentation
ENABLE_API_DOCS=true

# File storage (S3-compatible — works with Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT=
S3_BUCKET=coffee-shop-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
